# Application
APP_NAME=RegTech Copilot
APP_ENV=development
APP_LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000

# LLM provider: ollama, nvidia, huggingface
LLM_PROVIDER=ollama

# Local Ollama endpoint
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=REPLACE_WITH_INSTALLED_MODEL

# External provider credentials
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=

# RAG
VECTOR_STORE_PATH=data/vector_store
DOCUMENTS_PATH=data/documents
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=5

# Generation
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1200

# Upload limits
MAX_UPLOAD_SIZE_MB=20
